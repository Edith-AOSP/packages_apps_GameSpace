android_app {
    name: "GameSpace",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    resource_dirs: ["res"],
    defaults: [
        "SettingsLibDefaults",
    ],
    srcs: [
        "java/**/*.java",
        "java/**/*.kt",
        "java/**/*.aidl",
    ],
    jni_libs: [
        "libdiscord_partner_sdk",
        "libgamespace_discord",
    ],
    aidl: {
        local_include_dirs: ["java"],
    },
    static_libs: [
        "androidx.core_core-ktx",
        "androidx.appcompat_appcompat",
        "androidx.preference_preference",
        "com.google.android.material_material",
        "kotlin-stdlib",
        "kotlinx-coroutines-android",
        "gson",
        "hilt_android",
        "edith-preference",
        "discord_partner_sdk_java",
        "libwebrtc_java",
        "SettingsLibMainSwitchPreference",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.material3_material3",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.lifecycle_lifecycle-runtime",
        "androidx.lifecycle_lifecycle-viewmodel",
        "androidx.savedstate_savedstate",
    ],
    kotlincflags: [
        "-opt-in=kotlin.Experimental",
        "-opt-in=kotlin.ExperimentalStdlibApi",
    ],
    plugins: [
        "dagger2-compiler",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    required: [
        "ANGLE",
        "privapp_whitelist_io.chaldeaprjkt.gamespace.xml"
    ],
}

cc_library_shared {
    name: "libgamespace_discord",
    srcs: [
        "cpp/gamespace_discord_real.cpp",
    ],
    shared_libs: [
        "libdiscord_partner_sdk",
        "liblog",
    ],
    header_libs: [
        "jni_headers",
        "libdiscord_partner_sdk_headers",
    ],
    cpp_std: "c++20",
    stl: "c++_static",
}

prebuilt_etc_xml {
    name: "privapp_whitelist_io.chaldeaprjkt.gamespace.xml",
    src: "privapp_whitelist_io.chaldeaprjkt.gamespace.xml",
    system_ext_specific: true,
    filename_from_src: true,
    sub_dir: "permissions",
}
